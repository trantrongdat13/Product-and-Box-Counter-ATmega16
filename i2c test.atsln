/*
 * Product & Box Counter - LCD I2C
 * ATmega16 @16MHz
 * SDA = PC1
 * SCL = PC0
 */

#define F_CPU 16000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <stdio.h>

// =======================================================
// -------------------- I2C FUNCTIONS --------------------
// =======================================================

void I2C_Init(unsigned long scl_clock) {
    TWSR = 0x00;
    TWBR = ((F_CPU / scl_clock) - 16) / 2;  // TWI speed
}

void I2C_Start() {
    TWCR = (1<<TWINT) | (1<<TWSTA) | (1<<TWEN);
    while (!(TWCR & (1<<TWINT)));
}

void I2C_Stop() {
    TWCR = (1<<TWINT) | (1<<TWSTO) | (1<<TWEN);
}

void I2C_Write(unsigned char data) {
    TWDR = data;
    TWCR = (1<<TWINT) | (1<<TWEN);
    while (!(TWCR & (1<<TWINT)));
}

// =======================================================
// -------------------- LCD I2C (PCF8574) ----------------
// =======================================================

#define LCD_ADDR 0x27

void LCD_I2C_Send(unsigned char data) {
    I2C_Start();
    I2C_Write(LCD_ADDR << 1);
    I2C_Write(data);
    I2C_Stop();
}

void LCD_Command(unsigned char cmd) {
    unsigned char upper = cmd & 0xF0;
    unsigned char lower = (cmd << 4) & 0xF0;

    LCD_I2C_Send(upper | 0x0C); // EN = 1, RS = 0
    LCD_I2C_Send(upper | 0x08); // EN = 0

    LCD_I2C_Send(lower | 0x0C);
    LCD_I2C_Send(lower | 0x08);

    _delay_ms(2);
}

void LCD_Char(char data) {
    unsigned char upper = data & 0xF0;
    unsigned char lower = (data << 4) & 0xF0;

    LCD_I2C_Send(upper | 0x0D); // EN=1, RS=1
    LCD_I2C_Send(upper | 0x09); // EN=0

    LCD_I2C_Send(lower | 0x0D);
    LCD_I2C_Send(lower | 0x09);

    _delay_ms(2);
}

void LCD_String(char *str) {
    while(*str) LCD_Char(*str++);
}

void LCD_SetCursor(uint8_t row, uint8_t col) {
    uint8_t pos = (row == 0) ? (0x80 + col) : (0xC0 + col);
    LCD_Command(pos);
}

void LCD_Init() {
    _delay_ms(40);
    I2C_Init(100000); // 100kHz I2C

    LCD_Command(0x02);
    LCD_Command(0x28);
    LCD_Command(0x0C);
    LCD_Command(0x06);
    LCD_Command(0x01);
}

void LCD_Clear() {
    LCD_Command(0x01);
}

// =======================================================
// ---------------------- MAIN CODE ----------------------
// =======================================================

volatile uint8_t product_count = 0;
volatile uint16_t box_count = 0;

void LCD_Update() {
    char line1[17], line2[17];
    sprintf(line1, "San pham: %u  ", product_count);
    sprintf(line2, "So thung: %u   ", box_count);

    LCD_SetCursor(0, 0);
    LCD_String(line1);
    LCD_SetCursor(1, 0);
    LCD_String(line2);
}

// Interrupt SENSOR (INT0)
ISR(INT0_vect) {
    PORTD |= (1 << PD0);  // LED ON
    _delay_ms(80);
    PORTD &= ~(1 << PD0); // LED OFF

    product_count++;
    if (product_count >= 5) {
        product_count = 0;
        box_count++;
    }
    LCD_Update();
}

int main(void) {
    DDRD |= (1 << PD0);   // LED
    DDRD &= ~(1 << PD2);  // INT0 input

    LCD_Init();
    LCD_Update();

    // INT0 falling edge
    MCUCR |= (1 << ISC01);
    GICR |= (1 << INT0);
    sei();

    while (1) {
        // do nothing
    }
}
